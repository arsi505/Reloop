# Reloop Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env

# Runtime Ports
API_PORT=3101
WEB_PORT=3100
FRONTEND_URL=http://localhost:3100

# PostgreSQL Configuration
POSTGRES_USER=reloop
POSTGRES_PASSWORD=reloop_dev_password
POSTGRES_DB=reloop
POSTGRES_PORT=5433

# Database Connection URL (Host port 5433 maps to container port 5432)
DATABASE_URL="postgresql://reloop:reloop_dev_password@localhost:5433/reloop?schema=public"

# Redis Configuration (Host port 6380 maps to container port 6379)
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"
