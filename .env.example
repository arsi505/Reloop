# Reloop Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env

# Runtime Environment
NODE_ENV=development
API_PORT=3101
WEB_PORT=3100
FRONTEND_URL=http://localhost:3100

# PostgreSQL Container Bootstrap / Admin
POSTGRES_USER=reloop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=reloop
POSTGRES_PORT=5433

# Application Database Role Credentials
APP_DATABASE_USER=reloop_app
APP_DATABASE_PASSWORD=change_me

# Application Database Connection URLs (Host port 5433 maps to container port 5432)
# Uses non-superuser application role "reloop_app"
DATABASE_URL=postgresql://reloop_app:change_me@localhost:5433/reloop?schema=public
SHADOW_DATABASE_URL=postgresql://reloop_app:change_me@localhost:5433/reloop_shadow?schema=public
TEST_DATABASE_URL=postgresql://reloop_app:change_me@localhost:5433/reloop_test?schema=public

# Redis Configuration (Host port 6380 maps to container port 6379)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Authentication & Security Tokens
JWT_ACCESS_SECRET=replace_with_secure_random_secret_minimum_32_characters
JWT_ACCESS_TTL=15m
REFRESH_SESSION_TTL_DAYS=7
REFRESH_COOKIE_NAME=reloop_refresh

# Redis Streams Job Dispatch Scheduler & Workflow Coordinator
JOB_STREAM_KEY=reloop:jobs:ready
JOB_CONSUMER_GROUP=recovery-workers
SCHEDULER_INTERVAL_MS=1000
SCHEDULER_BATCH_SIZE=50
DISPATCH_MARKER_TTL_MS=30000
WORKFLOW_SCAN_INTERVAL_MS=1000
WORKFLOW_SCAN_BATCH_SIZE=20

# Distributed Worker Engine
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=5000
JOB_LEASE_DURATION_MS=15000
JOB_LEASE_RENEW_INTERVAL_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Worker Crash & Stale PEL Recovery (Day 9)
WORKER_RECOVERY_SCAN_INTERVAL_MS=5000
WORKER_PEL_MIN_IDLE_MS=20000
WORKER_RECOVERY_BATCH_SIZE=20

# Cross-System Reconciliation & Recovery Case Detection (Day 12)
RECONCILIATION_SCAN_INTERVAL_MS=5000
RECONCILIATION_SCAN_BATCH_SIZE=50

# Recovery Policy Router & Workflow Trigger (Day 13)
RECOVERY_ROUTER_SCAN_INTERVAL_MS=2000
RECOVERY_ROUTER_BATCH_SIZE=50

# Secure Webhook Ingestion & Event Deduplication (Day 14)
SIMULATOR_WEBHOOK_SECRET=reloop_simulator_webhook_secret_dev
WEBHOOK_MAX_PAYLOAD_BYTES=1048576